{
  "expo": {
    "name": "Jock Exchange",
    "slug": "jock-exchange",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "jockexchange",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07111F",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07111F"
    },
    "android": {
      "package": "com.jockexchange.app",
      "backgroundColor": "#07111F",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07111F"
      }
    },
    "ios": {
      "bundleIdentifier": "com.jockexchange.app",
      "backgroundColor": "#07111F",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#07111F",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1de130d3-a650-4397-ba50-eb525d880959"
      }
    },
    "owner": "mlcoffman"
  }
}
