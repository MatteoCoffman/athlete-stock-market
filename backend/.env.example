PORT=4000
JWT_SECRET=change-me-in-production
ADMIN_TOKEN=jock-admin-demo
# Currents News API (server-only — never expose to the client)
CURRENTS_API_KEY=
# Comma-separated browser origins for CORS (leave empty to allow any — local demo)
# CORS_ORIGINS=https://your-app.vercel.app
BOTS_ENABLED=1
BOT_COUNT=12
BOT_INTERVAL_MS=2800

# PostgreSQL — local app DB (migrations / future cutover). Not required for current SQLite runtime.
# Create the empty database first: CREATE DATABASE athlete_market_app;
# Do NOT point this at athlete_market_ml.
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/athlete_market_app
